---
// A replica of the product dashboard built from the app's own component styles. Sample data, clearly labelled.
import Icon from './Icon.astro';
const N = 28;
const rnd = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const make = (seed: number, base: number, amp: number, trend: number) => { const r = rnd(seed); return Array.from({ length: N }, (_, i) => Math.round(base + trend * i + (r() - 0.5) * amp + (i % 7 > 4 ? -amp * 0.25 : 0))); };
const metrics = [
  { k: 'Unique visitors', v: '4,300', d: '86.8%', dir: 'up', prev: 'vs 2.3K', data: make(7, 120, 90, 3.2), series: 'Unique visitors' },
  { k: 'Total visits', v: '4,300', d: '86.8%', dir: 'up', prev: 'vs 2.3K', data: make(11, 118, 88, 3.1), series: 'Total visits' },
  { k: 'Total pageviews', v: '11K', d: '84.8%', dir: 'up', prev: 'vs 5.9K', data: make(13, 310, 200, 8), series: 'Total pageviews' },
  { k: 'Views per visit', v: '2.56', d: '0.8%', dir: 'down', prev: 'vs 2.58', data: make(17, 2.5, 0.5, 0.004).map((n) => Math.round(n * 100) / 100), series: 'Views per visit' },
  { k: 'Bounce rate', v: '35%', d: '0%', dir: 'flat', prev: 'vs 35%', data: make(19, 35, 10, 0), series: 'Bounce rate' },
  { k: 'Visit duration', v: '2m 15s', d: '1.5%', dir: 'down', prev: 'vs 2m 17s', data: make(23, 135, 40, 0.1), series: 'Visit duration' },
];
const niceStep = (m: number) => { const raw = m / 4, p = 10 ** Math.floor(Math.log10(raw)); return [1, 2, 2.5, 5, 10].map((f) => f * p).find((v) => v >= raw)!; };
const charts = metrics.map((m) => {
  const step = niceStep(Math.max(...m.data) * 1.02), max = step * 4;
  const ticks = [1, 0.75, 0.5, 0.25, 0].map((f) => ({ f: 1 - f, label: step >= 1 ? String(Math.round(max * f)) : (max * f).toFixed(1) }));
  const pts = m.data.map((v, i) => [(i / (N - 1)) * 100, 100 - (v / max) * 100]);
  const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`).join(' ');
  return { ...m, ticks, line, area: `${line} L100 100 L0 100 Z` };
});
const dates = ['Sep 23', 'Sep 26', 'Sep 29', 'Oct 2', 'Oct 5', 'Oct 8', 'Oct 11', 'Oct 14', 'Oct 17', 'Oct 20'];
const lists = {
  sources: [['Organic Social', 1079], ['Organic Search', 1075], ['Direct', 831], ['Paid Search', 503], ['Email', 454], ['Referral', 358]],
  pages: [['/', 1739], ['/pricing', 1244], ['/blog/privacy-first-analytics', 1078], ['/blog', 1037], ['/docs', 1024], ['/docs/install', 960]],
};
const fmt = (n: number) => n.toLocaleString('en-US');
---
<div class="dash" aria-label="Sample Tidemark dashboard">
  <div class="toolbar">
    <span class="btn site"><Icon name="globe" /><b>example.com</b><Icon name="chevron-down" /></span>
    <span class="live"><i class="dot"></i><b>12</b> current visitors</span>
    <span class="sp"></span>
    <span class="btn hide-s"><Icon name="funnel" />Filter</span>
    <span class="btn"><Icon name="calendar" />Last 28 days</span>
  </div>
  <div class="card chartcard">
    <div class="metric-tabs" role="tablist" aria-label="Metric">
      {charts.map((m, i) => (
        <button class={`metric ${i === 0 ? 'on' : ''}`} role="tab" aria-selected={i === 0} data-i={i} type="button">
          <span class="k">{m.k}</span><span class="v">{m.v}</span>
          <span class="d"><span class={`delta ${m.dir}`}>{m.dir === 'up' && <Icon name="arrow-up" />}{m.dir === 'down' && <Icon name="arrow-down" />}{m.d}</span><span class="prevv">{m.prev}</span></span>
        </button>
      ))}
    </div>
    <div class="plot-wrap">
      {charts.map((m, i) => (
        <div class="plot" data-i={i} hidden={i !== 0}>
          <div class="ylab">{m.ticks.map((t) => <span style={`top:${t.f * 100}%`}>{t.label}</span>)}</div>
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label={`${m.series}, last 28 days (sample data)`}>
            {m.ticks.map((t) => <line x1="0" x2="100" y1={t.f * 100} y2={t.f * 100} class="g" />)}
            <path d={m.area} class="area" /><path d={m.line} class="ln" />
          </svg>
        </div>
      ))}
      <div class="xlab">{dates.map((d) => <span>{d}</span>)}</div>
    </div>
    <div class="legend-row"><span class="legend"><i></i><span id="series-name">Unique visitors</span></span><span class="muted">Sample data</span></div>
  </div>
  <div class="two">
    {(['sources', 'pages'] as const).map((key) => (
      <div class="card">
        <div class="card-h"><h3>{key === 'sources' ? 'Sources' : 'Pages'}</h3>
          <div class="tabs">{key === 'sources' ? <><button class="on" type="button">Channels</button><button type="button">Sources</button><button type="button">Campaigns</button></> : <><button class="on" type="button">Top pages</button><button type="button">Entry pages</button><button type="button">Exit pages</button></>}</div>
        </div>
        <div class="card-b">
          <div class="mhead"><span>{key === 'sources' ? 'Channel' : 'Top page'}</span><span>Visitors</span></div>
          <div class="mlist">
            {lists[key].map(([l, n]) => (
              <div class="mrow"><span class="bar" style={`width:${(Number(n) / Number(lists[key][0][1])) * 100}%`}></span><span class="l">{l}</span><span class="r">{fmt(Number(n))}</span></div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
<style>
  .dash { display: flex; flex-direction: column; gap: 14px; text-align: left; font-size: 14px; line-height: 1.5; pointer-events: auto; }
  .dash :global(.btn) { cursor: default; } .dash :global(.btn:active) { transform: none; }
  .toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .toolbar .sp { flex: 1; } .site b { font-weight: 600; } .live { display: inline-flex; align-items: center; gap: 7px; color: var(--ink-3); margin-left: 6px; } .live b { color: var(--ink); }
  .metric-tabs { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); border-bottom: 1px solid var(--line); }
  .metric { text-align: left; background: none; border: 0; border-right: 1px solid var(--line); padding: 16px 18px 14px; cursor: pointer; position: relative; display: flex; flex-direction: column; gap: 6px; min-width: 0; font: inherit; color: inherit; transition: background .12s; }
  .metric:last-child { border-right: 0; } .metric:hover { background: var(--surface-2); }
  .metric::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--series-1); transform: scaleX(0); transition: transform .2s var(--ease); } .metric.on::after { transform: scaleX(1); }
  .metric .k { font-size: 12.5px; color: var(--ink-3); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .metric.on .k { color: var(--accent-ink); }
  .metric .v { font-size: 26px; line-height: 1.1; font-weight: 600; letter-spacing: -.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .metric .d { display: flex; align-items: center; gap: 8px; min-height: 22px; font-size: 12px; } .prevv { color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .delta { font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 3px; padding: 0 7px; height: 20px; border-radius: 999px; font-variant-numeric: tabular-nums; }
  .delta .ico { width: 12px; height: 12px; vertical-align: 0; } .delta.up { background: var(--good-soft); color: var(--good); } .delta.down { background: var(--bad-soft); color: var(--bad); } .delta.flat { background: var(--surface-2); color: var(--ink-3); }
  .plot-wrap { padding: 22px 22px 6px 22px; }
  .plot { position: relative; height: 230px; margin-left: 38px; } .plot[hidden] { display: none; }
  .plot svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .plot .g { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; shape-rendering: crispEdges; }
  .plot .area { fill: var(--series-1-wash); } .plot .ln { fill: none; stroke: var(--series-1); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }
  .ylab { position: absolute; left: -38px; top: 0; bottom: 0; width: 30px; } .ylab span { position: absolute; right: 0; transform: translateY(-50%); font-size: 11.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .xlab { display: flex; justify-content: space-between; margin: 10px 0 0 38px; font-size: 11.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .legend-row { display: flex; justify-content: space-between; padding: 8px 22px 16px; font-size: 12.5px; }
  .legend { display: flex; align-items: center; gap: 6px; color: var(--ink-2); } .legend i { width: 10px; height: 10px; border-radius: 3px; background: var(--series-1); }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .card-h h3 { font-size: 13.5px; font-weight: 620; }
  .mhead { display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-3); padding: 2px 8px 6px; } .mhead span:last-child { padding-right: 0; }
  .mlist { display: flex; flex-direction: column; gap: 2px; }
  .mrow { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 8px; border-radius: 6px; min-height: 32px; }
  .mrow .bar { position: absolute; inset: 2px auto 2px 0; background: var(--series-1-wash); border-radius: 5px; z-index: 0; }
  .mrow .l, .mrow .r { position: relative; z-index: 1; } .mrow .l { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .mrow .r { font-variant-numeric: tabular-nums; font-weight: 560; }
  @media (max-width: 900px) { .metric-tabs { grid-auto-flow: row; grid-template-columns: repeat(3, minmax(0, 1fr)); } .metric { border-bottom: 1px solid var(--line); } .metric:nth-child(3n) { border-right: 0; } .metric.on::after { bottom: -1px; } .two { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .metric-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); } .metric:nth-child(3n) { border-right: 1px solid var(--line); } .metric:nth-child(2n) { border-right: 0; } .hide-s { display: none; } .plot-wrap { padding: 18px 14px 4px; } .metric .v { font-size: 22px; } .xlab span:nth-child(even) { display: none; } }
</style>
<script>
  const root = document.querySelector('.dash');
  const name = document.getElementById('series-name');
  root?.querySelectorAll<HTMLButtonElement>('.metric').forEach((b) => b.addEventListener('click', () => {
    const i = b.dataset.i;
    root.querySelectorAll('.metric').forEach((m) => { m.classList.toggle('on', m === b); m.setAttribute('aria-selected', String(m === b)); });
    root.querySelectorAll<HTMLElement>('.plot').forEach((p) => { p.hidden = p.dataset.i !== i; });
    if (name) name.textContent = b.querySelector('.k')?.textContent || '';
  }));
</script>
