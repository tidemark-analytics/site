---
import { site } from '../data/site';
const { id = 'waitlist' } = Astro.props;
---
<form class="wl" method="post" action={site.waitlistAction} id={id}>
  <label for={`${id}-email`} class="sr-only">Email address</label>
  <input id={`${id}-email`} type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
  <button class="btn primary lg" type="submit">Join the waitlist</button>
  <p class="help">One email when Tidemark Cloud opens. Nothing else, and you can ask us to delete it.</p>
</form>
<style>
  .wl { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; max-width: 480px; }
  .wl input[type="email"] { height: 42px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .help { grid-column: 1 / -1; font-size: 12.5px; color: var(--ink-3); margin-top: 2px; }
  @media (max-width: 520px) { .wl { grid-template-columns: 1fr; } }
</style>
