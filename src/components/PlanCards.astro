---
import { site } from '../data/site';
---
<div class="plans3">
  <article class="card pad plan">
    <h3>Cloud Free</h3>
    <p class="tag">Try it on a real site.</p>
    <div class="price">$0</div>
    <p class="alt">No credit card needed</p>
    <ul class="ticks"><li>1 site</li><li>10,000 events a month</li><li>6 months of history</li><li>All reports, filters, goals and shared links</li></ul>
    <a class="btn lg" href={site.signupUrl}>Start free</a>
  </article>
  <article class="card pad plan hl">
    <span class="pill brand">Most popular</span>
    <h3>Cloud Pro</h3>
    <p class="tag">For sites that grow.</p>
    <div class="price">$7 <small>/ month</small></div>
    <p class="alt">or $70 a year, two months free</p>
    <ul class="ticks"><li>Unlimited sites</li><li>250,000 events a month</li><li>5 years of history</li><li>Everything in Free</li></ul>
    <a class="btn primary lg" href={site.signupUrl}>Start free, upgrade later</a>
  </article>
  <article class="card pad plan">
    <h3>Self-hosted</h3>
    <p class="tag">Run it yourself.</p>
    <div class="price">$0 <small>forever</small></div>
    <p class="alt">You provide the PHP host</p>
    <ul class="ticks"><li>MIT license, unlimited everything</li><li>Any PHP 8.3+ host, even shared</li><li>Your data in your own database</li><li>One-click in-app updates</li></ul>
    <a class="btn lg" href="/self-host/">How self-hosting works</a>
  </article>
</div>
