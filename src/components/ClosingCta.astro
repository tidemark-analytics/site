---
import { site } from '../data/site';
const { title = 'Clear water. Honest numbers.', text = 'Create a free account and see your first visitor in about two minutes.' } = Astro.props;
import Logo from './Logo.astro';
---
<section class="wash closing">
  <div class="wrap">
    <div class="card end">
      <div class="mark"><Logo variant="mark" /></div>
      <h2>{title}</h2>
      <p class="muted">{text}</p>
      <div class="cta"><a class="btn primary lg" href={site.signupUrl}>Start free</a><a class="btn lg" href="/self-host/">Self-host instead</a></div>
    </div>
  </div>
</section>
