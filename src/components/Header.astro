---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---
<header class="topbar">
  <div class="topbar-in">
    <a href="/" class="brand" aria-label="Tidemark — home"><Logo /></a>
    <nav class="topnav" id="topnav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.href.startsWith('/') && path.startsWith(n.href) ? 'page' : undefined}>{n.label}{n.badge && <span class="pill warn">{n.badge}</span>}</a>
      ))}
      <a class="nav-signin" href={site.appUrl}>Sign in</a>
    </nav>
    <div class="top-actions">
      <a class="btn ghost signin" href={site.appUrl}>Sign in</a>
      <a class="btn primary start" href={site.signupUrl}>Start free</a>
      <a class="btn primary nav-dash" href={`${site.appUrl}/sites`}>Dashboard</a>
      <button class="btn ghost icon menu-btn" id="menu" type="button" aria-expanded="false" aria-controls="topnav" aria-label="Menu"><svg class="ico" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
    </div>
  </div>
</header>
<script>
  const nav = document.getElementById('topnav');
  const menu = document.getElementById('menu');
  menu?.addEventListener('click', () => {
    const open = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', String(!open));
    menu.setAttribute('aria-expanded', String(!open));
  });
</script>
