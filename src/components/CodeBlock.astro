---
import Icon from './Icon.astro';
const { code, html } = Astro.props;
---
<div class="code">
  {html ? <pre set:html={html} /> : <pre>{code}</pre>}
  <button class="btn sm icon copy" type="button" aria-label="Copy to clipboard" data-code={code}><Icon name="copy" /></button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => {
    if (b.dataset.bound) return; b.dataset.bound = '1';
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.code || ''); b.setAttribute('aria-label', 'Copied'); b.style.color = 'var(--good)'; setTimeout(() => { b.setAttribute('aria-label', 'Copy to clipboard'); b.style.color = ''; }, 1600); } catch {}
    });
  });
</script>
