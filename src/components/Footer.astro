---
import { site } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-in">
      <div><a href="/" class="brand" aria-label="Tidemark — home"><Logo /></a><p class="about">Privacy-first web analytics that runs on any PHP host — or on ours.</p></div>
      <nav aria-label="Product"><h2>Product</h2><a href="/features/">Features</a><a href="/install/">Install</a><a href="/privacy/">Privacy</a><a href="/compare/">Compare</a><a href="/cloud/">Cloud (soon)</a></nav>
      <nav aria-label="Project"><h2>Project</h2><a href={site.downloadUrl}>Download v{site.version}</a><a href={site.repoUrl}>Source on GitHub</a></nav>
    </div>
    <div class="foot-base"><span>© {year} Tidemark · MIT license</span><span>This site sets no cookies and runs no trackers.</span></div>
  </div>
</footer>
