---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Page not found" noindex>
  <div class="wrap page-head nf">
    <h1>That page isn’t here.</h1>
    <p class="lede">The link may be old, or the address mistyped.</p>
    <div class="cta"><a class="btn primary lg" href="/">Back to the home page</a><a class="btn lg" href={site.docsUrl}>Read the docs</a></div>
  </div>
</Base>
