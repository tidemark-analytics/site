---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Faq from '../components/Faq.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site } from '../data/site';

const snippet = '<script defer data-domain="example.com"\n  src="https://stats.example.com/js/script.js"></script>';
const snippetHtml = `<span class="k">&lt;script</span> defer data-domain=<span class="s">"example.com"</span>\n  src=<span class="s">"https://stats.example.com/js/script.js"</span><span class="k">&gt;&lt;/script&gt;</span>`;
const faqs = [
  { q: 'Does Tidemark really run on shared hosting?', a: 'Yes. It is a PHP application with a bundled set of dependencies. You upload a zip, open /install and follow the steps. It needs PHP 8.3 or newer and a handful of common extensions, and it works with SQLite, MySQL, MariaDB or PostgreSQL. No Node, Docker or SSH is required.' },
  { q: 'Is self-hosting the same product as Cloud?', a: 'Yes. Cloud is this same open-source dashboard, run for you, with plans and billing added on top. Nothing in the dashboard is held back from the self-hosted version.' },
  { q: 'How do updates work?', a: 'The dashboard checks for new releases and can install them in one click, or you can upload the new zip yourself. Your configuration and data are kept.' },
  { q: 'Can I move to Cloud later, or back?', a: 'Yes. Export a site from Site settings, then import the file into the other install. Imports can be repeated safely, and goals come along.' },
];
const ld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base title="Self-host Tidemark on any PHP host" description="Install Tidemark on ordinary PHP shared hosting in minutes: upload a zip, open /install, paste one line. Free and open source under the MIT license." jsonLd={ld} crumbs={[{ name: 'Self-host', path: '/self-host/' }]}>
  <PageHero kicker="Open source · MIT license" title="Run Tidemark on the hosting you already have.">
    Upload a zip, open <code>/install</code>, and read your traffic on one calm page. Free forever, with your data in a database you control. Prefer not to run anything? <a class="link" href="/cloud/">Tidemark Cloud</a> is the same dashboard, hosted for you.
    <Fragment slot="actions">
      <div class="cta">
        <a class="btn primary lg" href={site.zipUrl} data-zip><Icon name="download" /><span>Download v<span data-ver>{site.version}</span> (zip)</span></a>
        <a class="btn lg" href={site.installDocsUrl}>Install guide <Icon name="arrow-right" /></a>
      </div>
      <p class="meta">Latest: <a href={site.releaseUrl} data-release>v<span data-ver>{site.version}</span></a> · {site.requirements} · SQLite, MySQL, MariaDB or PostgreSQL · no Node, Docker or SSH</p>
    </Fragment>
  </PageHero>

  <section class="section" id="install">
    <div class="wrap split">
      <div>
        <h2>Four steps. No terminal.</h2>
        <ol class="steps">
          <li><b>Upload</b> the release zip to your host and unzip it. Point the domain at the <code>public/</code> folder, or leave it: a bundled <code>.htaccess</code> forwards requests and blocks internals.</li>
          <li><b>Open <code>/install</code></b>. Tidemark checks your server, connects a database, runs the migrations and creates your admin account.</li>
          <li><b>Add the snippet</b> to your site’s <code>&lt;head&gt;</code>. The dashboard waits for the first pageview, then opens by itself.</li>
          <li><b>Add a cron job</b> in cPanel, only if you want queued ingestion and data retention.</li>
        </ol>
        <a class="btn" href={site.installDocsUrl}>Full install guide <Icon name="arrow-right" /></a>
      </div>
      <div class="stack">
        <p class="muted small">Paste this into your site</p>
        <CodeBlock code={snippet} html={snippetHtml} />
        <div class="notice"><Icon name="info" /><span>The script is about 2 KB gzipped, loads deferred, and sends a pageview on load and on every history change, so single-page apps work without extra code.</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Self-hosted or Cloud?</h2><p>Same software either way. Pick by who you want to look after the server.</p></div>
      <div class="grid2">
        <article class="card pad feat"><h3>Self-host if you</h3><p>already pay for PHP hosting, want the data in your own database, and don’t mind applying updates from the dashboard. It costs nothing beyond the hosting you have.</p></article>
        <article class="card pad feat"><h3>Choose Cloud if you</h3><p>would rather not run or back up anything, and want to be live in two minutes. Updates, uptime and backups are handled for you, free to start and $7 a month for Pro.</p><div class="cta" style="margin-top:18px"><a class="btn primary" href={site.signupUrl}>Start free</a><a class="textlink" href="/cloud/">See pricing <Icon name="arrow-right" /></a></div></article>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head"><h2>Self-hosting questions</h2></div>
      <Faq items={faqs} />
    </div>
  </section>
  <ClosingCta />
</Base>
<style>
  .small { font-size: 13px; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 72px); align-items: start; }
  .split > * { min-width: 0; } @media (max-width: 860px) { .split { grid-template-columns: minmax(0, 1fr); } }
  .steps { padding-left: 1.3em; margin: 20px 0 24px; color: var(--ink-2); font-size: 15.5px; display: grid; gap: 12px; } .steps li { padding-left: 6px; } .steps b { color: var(--ink); font-weight: 600; }
  .stack { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
</style>
