---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Dashboard from '../components/Dashboard.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Logo from '../components/Logo.astro';
import PlanCards from '../components/PlanCards.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site } from '../data/site';

const snippet = '<script defer data-domain="yourdomain.com"\n  src="https://app.tidemarkanalytics.com/js/script.js"></script>';
const snippetHtml = `<span class="k">&lt;script</span> defer data-domain=<span class="s">"yourdomain.com"</span>\n  src=<span class="s">"https://app.tidemarkanalytics.com/js/script.js"</span><span class="k">&gt;&lt;/script&gt;</span>`;

const faqs = [
  { q: 'Is the free plan really free?', a: 'Yes. Cloud Free gives you one site, 10,000 events a month and six months of history, with every report, filter, goal and shared link. No credit card is asked for. If you go over 10,000 events, new events pause until the month resets and nothing already collected is lost.' },
  { q: 'What counts as an event?', a: 'A pageview or a custom event, such as a signup or a download click. Most small sites use a few thousand a month.' },
  { q: 'Do I need a cookie banner?', a: 'Tidemark sets no cookies and stores no IP addresses or other personal data about visitors. Whether you need a consent banner depends on your jurisdiction and the rest of your site, so check with someone qualified. We do not make legal promises on your behalf.' },
  { q: 'How does it count visitors without cookies?', a: 'A visitor is a salted hash of site, IP address and user agent. The salt changes every day, and the IP address and user agent are never written to the database. Nobody can be followed from one day to the next.' },
  { q: 'Can I switch from Plausible or move between Cloud and self-hosted?', a: 'The tracking script and Events API follow Plausible’s conventions, so in most setups you change the script URL and nothing else. Tidemark can also export a site’s data and import it into another install, which makes moving between Cloud and self-hosted a download and an upload. Importing from Plausible itself is not supported yet.' },
  { q: 'Can I cancel or get a refund?', a: 'Cancel any time from your account. Pro stays active until the end of the period you paid for, and within 30 days of any payment you can ask for a full refund, no questions asked.' },
  { q: 'Does Tidemark really run on shared hosting?', a: 'Yes. It is a PHP application with a bundled set of dependencies. You upload a zip, open /install and follow the steps. It needs PHP 8.3 or newer and a handful of common extensions, and it works with SQLite, MySQL, MariaDB or PostgreSQL. No Node, Docker or SSH is required.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Tidemark', applicationCategory: 'BusinessApplication', applicationSubCategory: 'Web analytics', operatingSystem: 'Web, or any server running PHP 8.3+', description: site.description, softwareVersion: site.version, license: 'https://opensource.org/license/mit',
    offers: [{ '@type': 'Offer', name: 'Cloud Free', price: '0', priceCurrency: 'USD' }, { '@type': 'Offer', name: 'Cloud Pro (monthly)', price: '7', priceCurrency: 'USD' }, { '@type': 'Offer', name: 'Self-hosted', price: '0', priceCurrency: 'USD' }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Tidemark', url: Astro.site?.href },
];
---
<Base title="Tidemark — Privacy-first web analytics, free to start" description="Cookie-free, privacy-first web analytics on one calm page. Start free on Tidemark Cloud, or self-host on any PHP host. No cookies, no stored IP addresses." jsonLd={ld}>
  <section class="wash hero">
    <div class="wrap">
      <span class="pill brand kicker">Privacy-first web analytics</span>
      <h1>Measure the <span class="tide">tide</span>,<br />not the footprints.</h1>
      <p class="lede">Tidemark shows you where your visitors come from and what they read, on one calm page. No cookies, no stored IP addresses, nothing to put in a consent banner. <b>Start free in a minute</b>, or run it yourself on any PHP host.</p>
      <div class="cta">
        <a class="btn primary lg" href={site.signupUrl}>Start free</a>
        {site.demoUrl ? <a class="btn lg" href={site.demoUrl}>View live demo</a> : null}
        <a class="textlink" href="/self-host/">Or self-host it <Icon name="arrow-right" /></a>
      </div>
      <p class="meta">Free plan, no credit card · Pro is $7 a month · Open source (MIT)</p>
      <div class="shot"><Dashboard /></div>
    </div>
  </section>

  <div class="strip"><div class="wrap"><div class="trust">
    <span><Icon name="shield-check" />No cookies</span>
    <span><Icon name="lock" />No stored IP addresses</span>
    <span><Icon name="code" />Open source, MIT</span>
    <span><Icon name="cloud" />Hosted, or on your own PHP host</span>
    <span><Icon name="refresh-cw" />Plausible-compatible script</span>
  </div></div></div>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Everything you check, none of the surveillance.</h2><p>A tidemark is the line a tide leaves on a harbor wall: a record of how high the water reached, kept without keeping the water. Tidemark does that for your website.</p></div>
      <div class="grid3">
        <article class="card pad"><div class="empty-ico"><Icon name="chart-column" /></div><h3>One calm page</h3><p class="body">Visitors, visits, pageviews, bounce rate and visit duration, with sources, pages, locations, devices and goals underneath. You reach the bottom of your data in one screen.</p></article>
        <article class="card pad"><div class="empty-ico"><Icon name="shield-check" /></div><h3>Private by design</h3><p class="body">No cookies and no stored IP addresses. Visitor ids are a salted hash that changes every day, so nobody can be followed from one day to the next. Nothing to disclose, because nothing is kept.</p></article>
        <article class="card pad"><div class="empty-ico"><Icon name="refresh-cw" /></div><h3>No lock-in</h3><p class="body">The software is open source. Export a site and import it into any other Tidemark install, so you can start on Cloud and move to your own server later, or the other way around.</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap split">
      <div>
        <h2>Live in about two minutes.</h2>
        <ol class="steps">
          <li><b>Create a free account.</b> No credit card, and no server to set up.</li>
          <li><b>Add your site</b> and paste one line into its <code>&lt;head&gt;</code>. The script is about 2 KB and works with single-page apps out of the box.</li>
          <li><b>Open the dashboard.</b> It opens by itself after the first pageview.</li>
        </ol>
        <div class="cta" style="margin-top:0"><a class="btn primary lg" href={site.signupUrl}>Start free</a><a class="textlink" href={site.docsUrl}>Read the docs <Icon name="arrow-right" /></a></div>
      </div>
      <div class="stack">
        <p class="muted small">Paste this into your site</p>
        <CodeBlock code={snippet} html={snippetHtml} />
        <div class="notice"><Icon name="info" /><span>Already use Plausible? The script and Events API follow its conventions, so most sites only change the script address.</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Everything you check weekly. Nothing you don’t.</h2></div>
      <div class="grid3">
        {[
          ['chart-column', 'One-page dashboard', 'Six headline metrics, period comparison, and a graph with hour, day, week or month intervals. Every chart has a table view.'],
          ['funnel', 'Filters on anything', 'Click any row to filter. Use is, is not, contains, wildcards like /blog/*, and several values per filter.'],
          ['target', 'Goals and events', 'Custom events, properties, outbound links, file downloads and form submissions, picked by script file name.'],
          ['globe', 'Locations and devices', 'Countries, regions, cities, browsers, operating systems and device types, without profiling anyone.'],
          ['link', 'Sharing', 'Make a dashboard public, or create private links with an optional password.'],
          ['key', 'API and export', 'A Plausible-style Stats API with API keys, CSV and full-data export, roles per site and two-factor sign-in.'],
        ].map(([i, t, d]) => (
          <article class="card pad"><div class="empty-ico"><Icon name={i} /></div><h3>{t}</h3><p class="body">{d}</p></article>
        ))}
      </div>
      <p class="more"><a class="link" href="/features/">See all features</a> · Switch period with <span class="kbd">D</span> <span class="kbd">W</span> <span class="kbd">M</span> <span class="kbd">Y</span>, compare with <span class="kbd">X</span>, filter with <span class="kbd">F</span>.</p>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="wrap">
      <div class="section-head"><h2>Start free. Pay only when you outgrow it.</h2><p>One paid plan, no per-seat pricing and no surprise tiers. Prices are in US dollars.</p></div>
      <PlanCards />
      <p class="finep">Cancel any time. Full refund within 30 days of any payment, no questions asked: see the <a class="link" href="/refunds/">refund policy</a>. Payments are handled by Creem, our merchant of record, who also collect any VAT or sales tax. <a class="link" href="/cloud/">Pricing details and FAQ</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card pad dogfood">
        <div>
          <span class="pill brand kicker"><Icon name="eye" />Nothing to hide</span>
          <h2>This website runs on Tidemark Cloud.</h2>
          <p class="body big">Its dashboard is public, so you can see real numbers on the real product instead of a screenshot. <a class="link" href="/compare/">Compare Tidemark with Plausible, Umami, Matomo and Fathom</a>.</p>
        </div>
        {site.demoUrl ? <div class="wlbox"><a class="btn lg" href={site.demoUrl}>See this site’s live stats <Icon name="arrow-right" /></a></div> : null}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head"><h2>Questions, answered plainly.</h2></div>
      <Faq items={faqs} />
    </div>
  </section>

  <ClosingCta />
</Base>
<style>
  .hero { padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 72px); }
  .hero h1 { margin-bottom: 20px; }
  .tide { color: var(--accent); }
  .lede { max-width: 60ch; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.55; color: var(--ink-2); }
  .lede b { color: var(--ink); font-weight: 600; }
  .meta { margin-top: 16px; font-size: 13.5px; color: var(--ink-3); }
  .shot { margin-top: clamp(36px, 5vw, 60px); }
  .body { color: var(--ink-2); font-size: 14.5px; line-height: 1.6; margin-top: 6px; }
  .small { font-size: 13px; }
  .grid3 :global(.empty-ico) { margin-bottom: 14px; }
  .more { margin-top: 24px; font-size: 14px; color: var(--ink-3); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 72px); align-items: center; }
  .split > * { min-width: 0; } @media (max-width: 860px) { .split { grid-template-columns: minmax(0, 1fr); } }
  .steps { padding-left: 1.3em; margin: 20px 0 24px; color: var(--ink-2); font-size: 15.5px; display: grid; gap: 12px; } .steps li { padding-left: 6px; } .steps b { color: var(--ink); font-weight: 600; }
  .stack { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .dogfood { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 32px; align-items: center; padding: clamp(24px, 4vw, 40px); }
  .dogfood h2 { margin-bottom: 10px; } .big { font-size: 16px; margin-top: 0; } .wlbox { min-width: 0; display: flex; justify-content: flex-end; }
  @media (max-width: 860px) { .dogfood { grid-template-columns: minmax(0, 1fr); } .wlbox { justify-content: flex-start; } }
</style>