---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.order - b.data.order);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const ld = [{ '@context': 'https://schema.org', '@type': 'Blog', name: 'The Tidemark blog', url: new URL('/blog/', Astro.site).href, description: 'Guides to web analytics that respect your visitors: choosing a tool, moving off Google Analytics, self-hosting and counting without cookies.' }];
---
<Base title="Blog: web analytics without the tracking" description="Guides to web analytics that respect your visitors: alternatives to Google Analytics, self-hosting, cookieless counting and the metrics that matter." jsonLd={ld} crumbs={[{ name: 'Blog', path: '/blog/' }]}>
  <PageHero kicker="Blog" title="Web analytics without the tracking.">
    <Icon slot="kicker-icon" name="layers" />
    Practical guides to choosing a tool, moving off Google Analytics, running your own and understanding what the numbers mean.
  </PageHero>
  <section class="section">
    <div class="wrap">
      <div class="posts">
        {posts.map((p) => (
          <a class="card post-card" href={`/blog/${p.id}/`}>
            <span class="pill">{p.data.tag}</span>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="meta">{fmt(p.data.date)}{p.data.readingMinutes ? ` · ${p.data.readingMinutes} min read` : ''}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .posts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .post-card { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 22px 24px; color: inherit; text-decoration: none; transition: border-color .15s, transform .15s; }
  .post-card:hover { border-color: var(--line-2); transform: translateY(-2px); }
  .post-card h2 { font-size: 19px; letter-spacing: -.02em; line-height: 1.3; }
  .post-card p { color: var(--ink-2); font-size: 14.5px; flex: 1; }
  .post-card .meta { color: var(--ink-3); font-size: 13px; }
  @media (max-width: 760px) { .posts { grid-template-columns: minmax(0, 1fr); } }
</style>
