---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PlanCards from '../../components/PlanCards.astro';
import Faq from '../../components/Faq.astro';
import PageHero from '../../components/PageHero.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { site } from '../../data/site';

const ossDocs = 'https://docs.tidemarkanalytics.com/article/135-open-source-program';
const nonprofitDocs = 'https://docs.tidemarkanalytics.com/article/136-non-profit-discount';

const faqs = [
  { q: 'What counts as an event?', a: 'Pageviews and custom events (such as a signup or a download click). Visits, sessions and the dashboard itself are not counted.' },
  { q: 'What happens if I go over my events?', a: 'On Free, new events stop being recorded until the month resets, and everything already collected stays. On Pro, 250,000 events a month are included (3,000,000 a year on the yearly plan). We email you at 80% and 100% of the events available to you. At 100% recording pauses until you top up with an extra-events pack or your billing period resets; everything already collected stays.' },
  { q: 'How do extra events work?', a: 'From Account settings → Plan & billing you can buy packs of 250,000 events for $5, as many as you like. They are used only after your included events, don’t expire while your account is open, and you are never charged automatically, so there are no surprise bills. Unused packs can be refunded within 30 days.' },
  { q: 'Is Pro free for open-source projects?', a: 'Yes, for non-commercial open-source projects: Pro is free, and you only pay if you go over the events included with Pro (extra event packs, at the normal price). The project must be open source and must not sell anything: no paid products, plans, hosting or support, and no ads. Approvals are reviewed by hand and last a year at a time. Email support@tidemarkanalytics.com with the project name, repository link, license and the site you want to measure.' },
  { q: 'Do you offer a discount for non-profits?', a: 'Yes: registered non-profits and charities get Pro for 50% off ($3.50 a month or $35 a year). Email support@tidemarkanalytics.com with the organisation’s legal name, website and official government documentation of its non-profit status. Approvals are reviewed by hand and last a year at a time.' },
  { q: 'What happens when a yearly approval ends?', a: 'About 30 days before an open-source or non-profit approval ends we check that you still qualify, and we may email you. If you do, we renew it for another year. If you don’t, or we can’t confirm it, it ends on its date: open-source accounts return to Free, and non-profit subscriptions continue at the normal price until cancelled.' },
  { q: 'Can I put my own branding on a public dashboard?', a: 'Yes, with Pro. Add your logo, a display name and a brand color, and visitors to the public dashboard or a shared link see them instead of the Tidemark header. A small “Analytics by Tidemark” link always stays in the footer. Self-hosted installs can brand their public pages for free.' },
  { q: 'What support do I get?', a: 'Cloud customers, on Free and Pro alike, get direct support: write to us from inside the app or at support@tidemarkanalytics.com and a person replies. Self-hosted installs are supported by the community on GitHub.' },
  { q: 'Can I cancel any time?', a: 'Yes. Cancel from Account settings → Plan & billing. Pro stays active until the end of the period you paid for. Within 30 days of any payment you can also ask for a full refund, no questions asked.' },
  { q: 'Who handles payments and tax?', a: 'Creem, our merchant of record. They process the payment, issue the receipt, and collect and remit VAT or sales tax, which may be added to the price at checkout.' },
  { q: 'Is my visitors’ data private?', a: 'Yes. Tidemark sets no cookies and never stores IP addresses or raw user agents. Visitor ids are a salted hash that changes every day. See the privacy notice for the details.' },
  { q: 'Can I bring my existing data?', a: 'If you run Tidemark yourself, yes: export a site from its settings and import the file into your Cloud site. Imports are safe to repeat, goals come along, and history older than your plan keeps is skipped. From Plausible, upload its export zip in the site’s settings and your history is added as daily totals, again skipping anything older than your plan keeps. Other analytics tools can’t be imported yet.' },
  { q: 'Can I run it myself instead?', a: 'Yes. Tidemark is open source (MIT) and installs on ordinary PHP hosting. Cloud is the same dashboard without the server to look after.' },
];
const ld = [{ '@context': 'https://schema.org', '@type': 'Product', name: 'Tidemark Cloud', description: 'Hosted privacy-first web analytics.', brand: { '@type': 'Brand', name: 'Tidemark' },
  offers: [{ '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' }, { '@type': 'Offer', name: 'Pro (monthly)', price: '7', priceCurrency: 'USD' }, { '@type': 'Offer', name: 'Pro (yearly)', price: '70', priceCurrency: 'USD' }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base title="Tidemark Cloud and pricing" description="Hosted, privacy-first web analytics. Start free, or go Pro for $7 a month: 250,000 events, unlimited sites and 5 years of history. No cookies, no stored IP addresses." jsonLd={ld} crumbs={[{ name: 'Cloud & pricing', path: '/cloud/' }]}>
  <PageHero kicker="Hosted by us" title="Tidemark Cloud">
    <Icon slot="kicker-icon" name="cloud" />
    The same calm one-page dashboard, without a server to run. Privacy-first analytics with no cookies and no stored IP addresses, for a few dollars a month. Start free; upgrade only when you need to.
    <div slot="actions" class="cta"><a class="btn primary lg" href={site.signupUrl}>Start free</a><a class="btn lg" href={site.appUrl}>Sign in</a></div>
  </PageHero>

  <section class="section" id="pricing">
    <div class="wrap">
      <div class="section-head"><h2>Simple pricing</h2><p>One paid plan. Prices are in US dollars; any VAT or sales tax is added at checkout.</p></div>
      <PlanCards />
      <p class="finep">Cancel any time. Full refund within 30 days of any payment, no questions asked: see the <a class="link" href="/refunds/">refund policy</a>. Payments are processed by Creem, our merchant of record.</p>
    </div>
  </section>

  <section class="section" id="programs">
    <div class="wrap">
      <div class="section-head"><h2>Open source and non-profits</h2><p>If your project or organisation fits, you shouldn’t have to pay full price. Both are reviewed by a person and renewed a year at a time.</p></div>
      <div class="grid2">
        <div class="card pad feat"><div class="empty-ico"><Icon name="code" /></div><h3>Open-source projects: Pro for free</h3><p>For non-commercial open-source projects that don’t sell anything. You get everything in Pro and only pay if you go over its events, with extra event packs at the normal price.</p><div class="cta" style="margin-top:18px"><a class="textlink" href={ossDocs}>How to apply <Icon name="arrow-right" /></a></div></div>
        <div class="card pad feat"><div class="empty-ico"><Icon name="users" /></div><h3>Non-profits: 50% off Pro</h3><p>For registered non-profits and charities: $3.50 a month or $35 a year. We ask for official government documentation of your status when you apply.</p><div class="cta" style="margin-top:18px"><a class="textlink" href={nonprofitDocs}>How to apply <Icon name="arrow-right" /></a></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid3">
        <div class="card pad feat"><div class="empty-ico"><Icon name="shield-check" /></div><h3>Private by design</h3><p>No cookies, no stored IP addresses, and visitor ids that change every day. You can’t be asked to hand over what we don’t keep.</p></div>
        <div class="card pad feat"><div class="empty-ico"><Icon name="chart-column" /></div><h3>Everything on one page</h3><p>Visitors, pageviews, bounce rate and duration, with sources, pages, locations, devices and goals underneath.</p></div>
        <div class="card pad feat"><div class="empty-ico"><Icon name="refresh-cw" /></div><h3>No lock-in</h3><p>The software is MIT licensed, and any site can be exported and imported into a self-hosted install. Leave whenever you like, with your data.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Questions</h2></div>
      <Faq items={faqs} />
      <p class="finep">By signing up you agree to the <a class="link" href="/terms/">Terms of Service</a> and acknowledge the <a class="link" href="/privacy/#cloud">privacy notice</a>. Questions? <a class="link" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>.</p>
    </div>
  </section>
  <ClosingCta />
</Base>
