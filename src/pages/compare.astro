---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCta from '../components/ClosingCta.astro';
const cols = ['Tidemark', 'Plausible', 'Umami', 'Matomo', 'Fathom'];
const rows = [
  ['Hosted version', 'Yes', 'Yes', 'Yes', 'Yes', 'Yes'],
  ['Self-host', 'Yes, MIT', 'Yes (Community Edition)', 'Yes, MIT', 'Yes, GPL', 'No'],
  ['Self-hosting needs', 'PHP 8.3+ and a database. Works on shared hosting', 'Docker, Postgres and ClickHouse', 'Node.js and a database', 'PHP and MySQL/MariaDB. Works on shared hosting', '—'],
  ['Cookie-free by default', 'Yes', 'Yes', 'Yes', 'Configurable', 'Yes'],
  ['Plausible-style tracking script and API', 'Yes', 'Native', 'No', 'No', 'No'],
  ['Product scope', 'Web analytics, one page', 'Web analytics, one page', 'Analytics, journeys, retention, replay', 'Full analytics suite', 'Web analytics'],
  ['Hosted price', 'Free tier, then $7/mo', 'From $9/mo', 'Free tier, paid plans', 'Paid plans', 'From about $15/mo'],
];
---
<Base title="Tidemark vs Plausible, Umami, Matomo and Fathom" description="How Tidemark compares with Plausible, Umami, Matomo and Fathom: where each runs, what self-hosting takes, and when a different tool is the better choice." crumbs={[{ name: 'Compare', path: '/compare/' }]}>
  <PageHero kicker="Compare" title="Tidemark and the alternatives.">All of these are good tools. The real difference is where they run and how much you want to operate. Here is the honest version.</PageHero>
  <section class="section">
  <div class="wrap">
    <div class="card tscroll"><table class="t">
      <thead><tr><th><span class="sr-only">Feature</span></th>{cols.map((c, i) => <th class={i === 0 ? 'us' : ''}>{c}</th>)}</tr></thead>
      <tbody>{rows.map((r) => <tr><th>{r[0]}</th>{r.slice(1).map((c, i) => <td class={i === 0 ? 'us' : ''}>{c}</td>)}</tr>)}</tbody>
    </table></div>
    <p class="finep">Based on public information from each project. Products and prices change, so check their pages before you decide, and tell us if something here is out of date.</p>
    <div class="grid2 choose">
      <section class="card pad feat">
        <h2>Choose Tidemark if</h2>
        <p><strong>You want hosted analytics with a real free plan.</strong> One flat paid plan at $7 a month, and the freedom to leave with your data.</p>
        <p><strong>You already pay for PHP hosting.</strong> Run it there, without Node, Docker or a database cluster.</p>
        <p><strong>You want one calm dashboard.</strong> The script is about 2 KB gzipped.</p>
        <p><strong>You already use Plausible’s script or API.</strong> Point it somewhere you control.</p>
      </section>
      <section class="card pad feat">
        <h2>Choose something else if</h2>
        <p><strong>You want the most established managed service.</strong> Plausible and Fathom are mature, hosted and well run, and have been for years. Tidemark Cloud is newer.</p>
        <p><strong>You need funnels, retention, session replay or revenue reports.</strong> Umami and Matomo go much further than Tidemark does.</p>
        <p><strong>You need to import history from a tool other than Plausible.</strong> Tidemark imports Plausible’s CSV export, but not other tools’ data yet.</p>
      </section>
    </div>
  </div>
  </section>
  <ClosingCta />
</Base>
