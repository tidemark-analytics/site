---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  jsonLd?: object[];
  noindex?: boolean;
  crumbs?: { name: string; path: string }[];
}
const { title, description = site.description, jsonLd = [], noindex = false, crumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} — Tidemark`;

const graph = [...jsonLd];
if (crumbs.length) {
  graph.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, Astro.site).href,
    })),
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>try{var t=localStorage.getItem("tm-theme");if(t)document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
    <meta name="theme-color" content="#f4f7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081418" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tidemark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tidemark: Measure the tide, not the footprints." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script defer data-domain="tidemarkanalytics.com" src="https://analytics.foggymtndrifter.com/js/script.outbound-links.file-downloads.form-submissions.js"></script>
    <script define:vars={{ endpoint: site.latestEndpoint }}>
      // Keep the version shown on download buttons current between rebuilds. Asks this site's own /latest.php (which caches
      // GitHub's answer), never GitHub itself, so visitors' browsers make no third-party request.
      window.addEventListener('load', () => {
        fetch(endpoint, { headers: { Accept: 'application/json' } })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            if (!d || !/^\d+\.\d+\.\d+/.test(d.version || '')) return;
            // only ever move forward: the page may have been built more recently than the endpoint's cached answer
            const shown = (document.querySelector('[data-ver]') || {}).textContent || '0.0.0';
            const n = (v) => v.split(/[.+-]/).slice(0, 3).map((x) => parseInt(x, 10) || 0);
            const [a, b] = [n(d.version), n(shown)];
            const diff = a[0] - b[0] || a[1] - b[1] || a[2] - b[2];
            if (diff <= 0) return;
            document.querySelectorAll('[data-ver]').forEach((el) => { el.textContent = d.version; });
            if (typeof d.url === 'string' && d.url.startsWith('https://github.com/')) document.querySelectorAll('a[data-release]').forEach((a) => { a.href = d.url; });
          })
          .catch(() => {});
      });
    </script>
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
